{
  "name": "repommender",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev:turbo": "concurrently \"npm run next-dev:turbo\" \"npm run fastapi-dev\"",
    "dev": "concurrently \"npm run next-dev\" \"npm run fastapi-dev\"",
    "fastapi-dev": "python -m uvicorn api.index:app --reload",
    "lint": "next lint",
    "next-dev:turbo": "next dev --turbo",
    "next-dev": "next dev",
    "setup:npm": "npm install && python -m pip install -r requirements.txt -r requirements-dev.txt && python setup/setup.py",
    "setup:pnpm": "pnpm install && python -m pip install -r requirements.txt -r requirements-dev.txt && python setup/setup.py",
    "start": "next start",
    "tunnel": "ngrok http --url=clearly-darling-seagull.ngrok-free.app http://localhost:3000"
  },
  "dependencies": {
    "@nextui-org/autocomplete": "^2.3.7",
    "@nextui-org/avatar": "^2.2.4",
    "@nextui-org/button": "2.2.7",
    "@nextui-org/card": "^2.2.7",
    "@nextui-org/code": "2.2.4",
    "@nextui-org/divider": "^2.2.4",
    "@nextui-org/image": "^2.2.3",
    "@nextui-org/input": "2.4.6",
    "@nextui-org/kbd": "2.2.4",
    "@nextui-org/link": "2.2.5",
    "@nextui-org/listbox": "2.3.7",
    "@nextui-org/navbar": "2.2.5",
    "@nextui-org/react": "^2.6.11",
    "@nextui-org/select": "^2.4.7",
    "@nextui-org/snippet": "2.2.8",
    "@nextui-org/spinner": "^2.2.4",
    "@nextui-org/switch": "2.2.6",
    "@nextui-org/system": "2.4.4",
    "@nextui-org/theme": "2.4.3",
    "@nextui-org/tooltip": "^2.2.5",
    "@react-aria/ssr": "3.9.6",
    "@react-aria/visually-hidden": "3.8.17",
    "@uiw/react-markdown-preview": "^5.1.3",
    "clsx": "2.1.1",
    "concurrently": "^9.0.1",
    "dotenv": "^16.4.5",
    "framer-motion": "~11.11.9",
    "intl-messageformat": "^10.7.0",
    "lucide-react": "^0.468.0",
    "next": "14.2.15",
    "next-themes": "^0.3.0",
    "nookies": "^2.5.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-use": "^17.5.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^14.2.15",
    "@types/node": "22.7.7",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.10.0",
    "@typescript-eslint/parser": "8.10.0",
    "autoprefixer": "10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "postcss": "8.4.47",
    "prettier": "^3.3.3",
    "prettier-eslint": "^16.3.0",
